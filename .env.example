# =============================================================================
# Ledgerstream — environment TEMPLATE (safe to commit: placeholders only)
#
# HOW TO USE
#   1. Copy this file:            cp .env.example .env
#   2. Fill real values in .env   (.env is gitignored — real secrets live ONLY there)
#   3. NEVER put a real password/URL in THIS file. It is committed.
#
# TWO RUN MODES (same code, different values — this portability is the point):
#   • CLOUD  (default daily dev): data stores on free tiers, Kafka+obs in Docker.
#                                 Guide: docs/cloud-free-tiers.md
#   • LOCAL  (offline demo):      everything in Docker:
#                                 docker compose --profile full up -d --wait
#
# Services run as NATIVE processes on your laptop, so every host below is
# `localhost` + the published port (see docker-compose.yml port mappings).
# In real production these come from a secrets manager (Vault / AWS SSM).
# =============================================================================

# -----------------------------------------------------------------------------
# Kafka + Schema Registry  — ALWAYS local Docker (both run modes)
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
SCHEMA_REGISTRY_URL=http://localhost:8081

# -----------------------------------------------------------------------------
# PostgreSQL — ONE database per service (database-per-service rule)
# -----------------------------------------------------------------------------
# CLOUD (Neon): create TWO databases in your project, paste each URL. Keep
#   ?sslmode=require. See docs/cloud-free-tiers.md (§Neon). The two URLs differ
#   only in the database name at the end.
PAYMENT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/payment?sslmode=require
LEDGER_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/ledger?sslmode=require
#
# LOCAL alternative (comment the two above, uncomment these):
# PAYMENT_DATABASE_URL=postgresql://payment:payment_dev_pw@localhost:5433/payment
# LEDGER_DATABASE_URL=postgresql://ledger:ledger_dev_pw@localhost:5434/ledger

# Local Postgres container-init vars — used ONLY by `--profile full` (LOCAL mode)
PAYMENT_DB_NAME=payment
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=payment_dev_pw
LEDGER_DB_NAME=ledger
LEDGER_DB_USER=ledger
LEDGER_DB_PASSWORD=ledger_dev_pw

# -----------------------------------------------------------------------------
# Redis — cache + rate-limit buckets
# -----------------------------------------------------------------------------
# CLOUD (Upstash): copy the rediss:// (TLS) URL from the console.
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
# LOCAL alternative:
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# MongoDB — ledger read model
# -----------------------------------------------------------------------------
# CLOUD (Atlas): copy the mongodb+srv:// URL from "Connect → Drivers".
MONGO_URL=mongodb+srv://USER:PASSWORD@HOST.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=ledger_read
# LOCAL alternative:
# MONGO_URL=mongodb://localhost:27017

# -----------------------------------------------------------------------------
# Observability — ALWAYS local Docker
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=otlp
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Auth — a real signing key is generated in Phase 1; this is a dev placeholder
# -----------------------------------------------------------------------------
JWT_SIGNING_KEY=dev-only-not-a-real-secret-change-me

# -----------------------------------------------------------------------------
# AI Query service (Phase 6) — LLM providers + gateway
# -----------------------------------------------------------------------------
# Provider API keys (SECRETS — real values go in .env only, never here).
# Leave BOTH empty to run the offline deterministic MOCK provider (no cost, no
# network). Set one or both for real answers; failover uses LLM_PROVIDER_ORDER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model ids (override to use a cheaper/different model)
CLAUDE_MODEL=claude-opus-5
OPENAI_MODEL=gpt-4o
# Provider preference + failover order (comma-separated: claude,openai,mock)
LLM_PROVIDER_ORDER=claude,openai,mock
# The AI service reads the ledger THROUGH the API Gateway (AI -> Gateway -> Ledger).
GATEWAY_BASE_URL=http://localhost:8010
# The MCP server (services/ai/app/mcp_server.py) needs a tenant-scoped token at
# RUNTIME (an env var you export when you launch it, not stored here):
#   LEDGERSTREAM_JWT=<a tenant-scoped access token>
